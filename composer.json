{
  "name": "railroad/railforums",
  "description": "Laravel forum system using entities",
  "license": "MIT",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "guzzlehttp/guzzle": "^7.2",
    "doctrine/dbal": "^3.0",
    "ezyang/htmlpurifier": "^4.10",
    "railroad/railnotifications": "4.0.*",
    "railroad/resora": "^3.0",
    "railroad/permissions": "^3.0",
    "symfony/dom-crawler": "^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "autoload": {
    "psr-4": {
      "Railroad\\Railforums\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
